          "schema_version",
          "mode",
          "evalscope_commit",
          "benchmark",
          "metrics",
          "primary_metric_id",
          "primary_output_key"
        ],
        "type": "object"
      },
      "source_ref": {
        "nullable": true,
        "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
        "type": "string"
      }
    },
    "required": [
      "provider",
      "provider_task_id",
      "dataset_version",
      "source_ref",
      "converter",
      "converter_options",
      "accepted_fidelity_digest",
      "model_name",
