                "id": { "pattern": "^[a-z][a-z0-9._-]{0,127}$", "type": "string" },
                "implementation_digest": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
                "output_keys": {
                  "items": { "maxLength": 128, "minLength": 1, "type": "string" },
                  "maxItems": 32,
                  "minItems": 1,
                  "type": "array"
                },
                "parameters": {
                  "additionalProperties": {
                    "anyOf": [
                      { "type": "boolean" },
                      { "type": "number" },
                      { "maxLength": 512, "minLength": 0, "type": "string" }
