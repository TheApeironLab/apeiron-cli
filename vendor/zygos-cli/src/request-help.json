              },
              "required": ["id", "implementation_digest", "parameters", "output_keys"],
              "type": "object"
            },
            "maxItems": 16,
            "minItems": 1,
            "type": "array"
          },
          "mode": { "enum": ["explicit"], "type": "string" },
          "primary_metric_id": { "pattern": "^[a-z][a-z0-9._-]{0,127}$", "type": "string" },
          "primary_output_key": { "maxLength": 128, "minLength": 1, "type": "string" },
          "schema_version": { "enum": [1], "type": "number" }
