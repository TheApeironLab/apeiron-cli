{
  "name": "@apeiron/cli",
  "version": "0.1.0-rc.1",
  "private": true,
  "type": "module",
  "description": "Unified Apeiron command-line entry point",
  "bin": {
    "apeiron": "bin/apeiron.ts"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "bun build ./bin/apeiron.ts --compile --outfile dist/apeiron",
    "build:release": "bun scripts/build-release.ts",
    "test:release": "bun scripts/smoke-release.ts",
    "test": "bun test",
    "test:ui": "bun scripts/test-ui.ts",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "playwright": "1.58.2",
    "typescript": "^5.9.3"
  }
}
